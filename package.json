{
  "name": "markdown-renderer",
  "version": "0.1.0",
  "type": "module",
  "description": "Renders ordinary markdown as a rich reading document and, on a keypress, as a presentation. No LLM required.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && vite build --config vite.config.cli.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:app": "vite build",
    "build:cli": "vite build --config vite.config.cli.ts",
    "mdr": "node dist-cli/mdr.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-directive": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^1.24.0",
    "unified": "^11.0.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "bin": {
    "mdr": "./dist-cli/mdr.mjs"
  },
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Abhishek Gupta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizdown/markdown-renderer.git"
  },
  "homepage": "https://github.com/wizdown/markdown-renderer#readme",
  "bugs": {
    "url": "https://github.com/wizdown/markdown-renderer/issues"
  },
  "keywords": [
    "markdown",
    "presentation",
    "slides",
    "renderer",
    "remark",
    "offline"
  ],
  "engines": {
    "node": ">=20"
  }
}
